{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profiles and roles",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "status": { "type": "string", "enum": ["pending", "approved", "active"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "Order": {
      "title": "Order",
      "description": "Service orders from clients",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhone": { "type": "string" },
        "userEmail": { "type": "string" },
        "serviceId": { "type": "string" },
        "serviceTitle": { "type": "string" },
        "details": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "paid", "approved", "cancelled"] },
        "paymentMethod": { "type": "string" },
        "paymentReference": { "type": "string" },
        "paymentPhone": { "type": "string" },
        "receiverPhone": { "type": "string" },
        "receiverName": { "type": "string" },
        "paidAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "serviceId", "amount", "status"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "Student course enrollments",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "paid", "approved", "cancelled"] },
        "paymentMethod": { "type": "string" },
        "paymentReference": { "type": "string" },
        "paymentPhone": { "type": "string" },
        "receiverPhone": { "type": "string" },
        "receiverName": { "type": "string" },
        "paidAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "courseId", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "User reviews for services or courses",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "content": { "type": "string" },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "approved": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "content", "rating"]
    },
    "Video": {
      "title": "Video",
      "description": "Training videos for courses",
      "type": "object",
      "properties": {
        "courseId": { "type": "string" },
        "title": { "type": "string" },
        "videoUrl": { "type": "string", "format": "uri" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["courseId", "title", "videoUrl"]
    },
    "progress": {
      "title": "Progress",
      "description": "User progress through course videos",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "videoId": { "type": "string" },
        "completed": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "courseId", "videoId", "completed"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notifications for approvals, updates, and events",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Contact form inquiries from users",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "subject": { "type": "string" },
        "category": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "read", "replied"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message", "status"]
    },
    "ErrorLog": {
      "title": "ErrorLog",
      "description": "Client-side runtime error logs",
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "stack": { "type": "string" },
        "componentStack": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "url": { "type": "string" },
        "userAgent": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["message", "timestamp"]
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Connection test document for health checks",
      "type": "object",
      "properties": {
        "status": { "type": "string" }
      }
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "Email addresses for newsletter subscriptions",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "subscribedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "subscribedAt"]
    }
  },
  "firestore": {
    "test/{docId}": {
      "schema": "TestConnection",
      "description": "Firestore connection health check"
    },
    "users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Service order documents"
    },
    "enrollments/{enrollmentId}": {
      "schema": "Enrollment",
      "description": "Course enrollment documents"
    },
    "notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Notification documents"
    },
    "reviews/{reviewId}": {
      "schema": "Review",
      "description": "User review documents"
    },
    "videos/{videoId}": {
      "schema": "Video",
      "description": "Course video documents"
    },
    "progress/{progressId}": {
      "schema": "progress",
      "description": "Course progress tracking"
    },
    "inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "User contact inquiries"
    },
    "error_logs/{logId}": {
      "schema": "ErrorLog",
      "description": "Application error logs"
    },
    "newsletter_subscribers/{subscriberId}": {
      "schema": "NewsletterSubscriber",
      "description": "Newsletter email list"
    }
  }
}
