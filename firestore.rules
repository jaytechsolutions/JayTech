rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'jaytechsolutions.net@gmail.com' ||
          request.auth.token.email.lower() == 'kobbijaysoftware@gmail.com' ||
          request.auth.token.email.lower() == 'admin@jaytechsolutions.com'
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Orders collection - allow anyone (client or guest) to submit service orders
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid));
      allow create: if true;
      allow update: if isAdmin() || (isSignedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid));
      allow delete: if isAdmin() || (isSignedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid));
    }

    // Enrollments collection
    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid));
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid));
      allow delete: if isAdmin() || (isSignedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid));
    }

    // Notifications collection - allow notification on order placement, allow admin/owner to read & manage
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid || isAdmin());
      allow create: if true;
      allow update, delete: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || isAdmin());
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Videos collection
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    // Progress collection
    match /progress/{progressId} {
      allow read: if isSignedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
    }

    // Connection test collection
    match /test/{docId} {
      allow read: if true;
    }
  }
}
